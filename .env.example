# Aegis Incident Agent Environment Configuration

# 1. Google Gemini API Key (Required for Agent LLMs)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. GitHub Credentials (Required for automated PR creation)
# Optional for local test mode (leave empty or set MOCK_GITHUB=true)
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_REPO=your_username/your_target_repo
MOCK_GITHUB=true

# 3. Agent Execution Configuration
MAX_REPAIR_ATTEMPTS=3
DEFAULT_TARGET_REPO_PATH=./sandbox/broken_service
API_HOST=0.0.0.0
API_PORT=8000
